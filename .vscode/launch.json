{
  // ローカルでアプリを起動してデバッグする（F5）。index.ts にブレークポイントを置いて http://localhost:3000/ を開く
  // Bedrock を呼ぶので、AWS の認証情報（環境変数か AWS_PROFILE）が必要
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "app (tsx)",
      "cwd": "${workspaceFolder}/app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "tsx", "src/index.ts"],
      "env": { "AWS_REGION": "ap-northeast-1" },
      "console": "integratedTerminal"
    }
  ]
}
